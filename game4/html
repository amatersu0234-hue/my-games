  try {
    localStorage.setItem(SAVE_KEY, JSON.stringify({
      depth: state.depth,
      coins: state.coins,
      pickaxeLv: state.pickaxeLv,
      clothLv: state.clothLv,
      roughRocks: state.roughRocks,
      discovered: state.discovered,
      pedestals: state.pedestals
    }));
  } catch (e) {}
}

