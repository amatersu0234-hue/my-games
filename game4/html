      ctx.moveTo(-r * 0.56, -r * 0.1);
      ctx.bezierCurveTo(-r * 0.68, -r * 0.65, -r * 0.35, -r * 0.92, 0, -r * 0.92);
      ctx.bezierCurveTo(r * 0.35, -r * 0.92, r * 0.68, -r * 0.65, r * 0.56, -r * 0.1);
      ctx.lineTo(r * 0.48, r * 0.22);
      ctx.lineTo(r * 0.34, r * 0.36);
      ctx.lineTo(r * 0.32, r * 0.82);
      ctx.lineTo(-r * 0.32, r * 0.82);
      ctx.lineTo(-r * 0.34, r * 0.36);
      ctx.lineTo(-r * 0.48, r * 0.22);
      ctx.closePath();
      break;
    }
    case 'crystal_ball': {
      ctx.beginPath();
      ctx.arc(0, -r * 0.12, r * 0.72, 0, Math.PI * 2);
      break;
    }
    case 'diamond': {
      ctx.beginPath();
      ctx.moveTo(-r * 0.52, -r * 0.68);
      ctx.lineTo(r * 0.52, -r * 0.68);
      ctx.lineTo(r * 0.92, -r * 0.22);
      ctx.lineTo(0, r * 0.92);
      ctx.lineTo(-r * 0.92, -r * 0.22);
      ctx.closePath();
      break;
    }
    case 'emerald_cut': {
      const w = r * 0.68, h = r * 0.88, c = r * 0.24;
      ctx.beginPath();
      ctx.moveTo(-w + c, -h); ctx.lineTo(w - c, -h);
      ctx.lineTo(w, -h + c); ctx.lineTo(w, h - c);
      ctx.lineTo(w - c, h); ctx.lineTo(-w + c, h);
      ctx.lineTo(-w, h - c); ctx.lineTo(-w, -h + c);
      ctx.closePath();
      break;
    }
    case 'teardrop': {
      ctx.beginPath();
      ctx.moveTo(0, -r * 0.95);
      ctx.bezierCurveTo(r * 0.78, -r * 0.1, r * 0.78, r * 0.92, 0, r * 0.92);
      ctx.bezierCurveTo(-r * 0.78, r * 0.92, -r * 0.78, -r * 0.1, 0, -r * 0.95);
      ctx.closePath();
      break;
