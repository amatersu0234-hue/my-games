    case 'heart': {
      ctx.beginPath();
      ctx.moveTo(0, r * 0.88);
      ctx.bezierCurveTo(-r * 1.15, r * 0.18, -r * 0.85, -r * 0.85, 0, -r * 0.32);
      ctx.bezierCurveTo(r * 0.85, -r * 0.85, r * 1.15, r * 0.18, 0, r * 0.88);
