function loadState() {
  try {
    const raw = localStorage.getItem(SAVE_KEY)
      || localStorage.getItem('gem_excavation_save_v4_3d')
      || localStorage.getItem('gem_excavation_save_v3');
    if (!raw) return;
    const data = JSON.parse(raw);
    Object.assign(state, data);
    if (!Array.isArray(state.pedestals) || state.pedestals.length !== 9) {
      state.pedestals = Array(9).fill(null);
    }
  } catch (e) {}
}

