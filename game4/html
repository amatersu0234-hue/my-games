      ctx.lineTo(-r * 0.45, r * 0.86);
      ctx.lineTo(-r * 0.72, -r * 0.22);
      ctx.closePath();
      break;
    }
    case 'lotus':
    default: {
      ctx.beginPath();
      for (let a = -0.75; a <= 0.75; a += 0.375) {
        const dx = Math.sin(a) * r * 0.22;
        const dy = -Math.cos(a) * r * 0.22;
        ctx.moveTo(dx + Math.cos(a) * r * 0.26, dy + Math.sin(a) * r * 0.26);
        ctx.ellipse(dx, dy, r * 0.26, r * 0.68, a, 0, Math.PI * 2);
      }
      break;
    }
  }
}

function drawGlossyGem(ctx, item, cx, cy, size, options = {}) {
  const {
    silhouetteOnly = false,
    cursed = false,
    forceGlow = null,
    yaw = 0,    // 3D左右回転角 (ラジアン)
    pitch = 0   // 3D上下傾き角 (ラジアン)
  } = options;

  const r = size * 0.44;
  const rInfo = RARITY_INFO[item.rarity] || RARITY_INFO.N;
  const hasGlow = forceGlow !== null ? forceGlow : (rInfo.glow || cursed);

  // 3D角度からの視差ベクトル＆パース圧縮計算
  const sinYaw = Math.sin(yaw);
  const cosYaw = Math.cos(yaw);
  const sinPitch = Math.sin(pitch);
  const cosPitch = Math.cos(pitch);

  // 背面・側面の厚みオフセット（角度が大きいほど側面が深く見える）
  const depthThickness = size * 0.13;
  const offX = -sinYaw * depthThickness;
  const offY = -sinPitch * depthThickness;

  // パース遠近スケール（傾きすぎない自然な3Dフォーショートニング）
  const scaleX = 0.78 + 0.22 * Math.abs(cosYaw);
  const scaleY = 0.82 + 0.18 * Math.abs(cosPitch);
  const skewX = sinYaw * sinPitch * 0.22;

  ctx.save();
  ctx.translate(cx, cy);

  // 1. 3D立体グラウンドシャドウ（浮遊感＆接地奥行き）
  if (!silhouetteOnly) {
    ctx.save();
    const shGrad = ctx.createRadialGradient(offX * 0.6, r * 0.96, 2, offX * 0.6, r * 0.96, r * 0.92);
    shGrad.addColorStop(0, 'rgba(0, 0, 0, 0.58)');
    shGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
    ctx.fillStyle = shGrad;
    ctx.beginPath();
    ctx.ellipse(offX * 0.6, r * 0.96, r * 0.85 * scaleX, r * 0.22, 0, 0, Math.PI * 2);
    ctx.fill();
    ctx.restore();
  }

  // 3D変形マトリクス適用
  ctx.transform(scaleX, 0, skewX, scaleY, 0, 0);

  // 2. 水晶玉の3D金属台座（背面→前面で立体感）
  if (item.shape === 'crystal_ball') {
    ctx.save();
    for (let layer = 3; layer >= 0; layer--) {
      const t = layer / 3;
      ctx.save();
      ctx.translate(offX * t * 0.8, offY * t * 0.8);
      const pedGrad = ctx.createLinearGradient(-r * 0.55, r * 0.5, r * 0.55, r * 0.92);
      if (layer > 0) {
        pedGrad.addColorStop(0, silhouetteOnly ? '#0f172a' : '#78350f');
        pedGrad.addColorStop(1, '#1c0a00');
      } else {
        pedGrad.addColorStop(0, silhouetteOnly ? '#1e293b' : '#fef08a');
        pedGrad.addColorStop(0.5, silhouetteOnly ? '#0f172a' : '#b45309');
        pedGrad.addColorStop(1, silhouetteOnly ? '#020617' : '#451a03');
      }
      ctx.fillStyle = pedGrad;
      ctx.beginPath();
      ctx.moveTo(-r * 0.42, r * 0.56);
      ctx.lineTo(r * 0.42, r * 0.56);
      ctx.lineTo(r * 0.62, r * 0.88);
      ctx.lineTo(-r * 0.62, r * 0.88);
      ctx.closePath();
      ctx.fill();
      if (layer === 0) {
        ctx.strokeStyle = 'rgba(255,255,255,0.5)';
        ctx.lineWidth = Math.max(1, size * 0.012);
        ctx.stroke();
      }
      ctx.restore();
    }
    ctx.restore();
  }

  // 3. 指輪の3D立体リングバンド
  if (item.shape === 'ring') {
    ctx.save();
    for (let layer = 4; layer >= 0; layer--) {
      const t = layer / 4;
      ctx.save();
      ctx.translate(offX * t * 0.9, offY * t * 0.9);
      ctx.beginPath();
      ctx.arc(0, r * 0.15, r * 0.66, 0, Math.PI * 2);
      ctx.strokeStyle = silhouetteOnly
        ? '#1e293b'
        : (layer === 0 ? '#fde047' : '#92400e');
      ctx.lineWidth = size * 0.085;
      ctx.stroke();
      ctx.restore();
    }
    ctx.restore();
  }

  // 4. 擬似3D 押し出し厚みレイヤー（背面・側面の立体ファセット層）
  // 球体(crystal_ball)は球面シェーディングで立体感を出すため、多面体・秘宝に厚み層を描画
  if (item.shape !== 'crystal_ball') {
    const steps = 6;
    for (let s = steps; s >= 1; s--) {
      const t = s / steps;
      ctx.save();
      ctx.translate(offX * t, offY * t);
      traceGemShapePath(ctx, item.shape, r);

      if (silhouetteOnly) {
        ctx.fillStyle = `rgba(15, 23, 42, ${0.55 - t * 0.25})`;
      } else if (cursed) {
        ctx.fillStyle = s % 2 === 0 ? '#4a044e' : '#2e1065';
      } else {
        ctx.fillStyle = item.c2;
      }
      ctx.fill();

      // 側面のファセット境界エッジ（立体カットの筋）
      if (!silhouetteOnly && s === steps) {
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.28)';
        ctx.lineWidth = Math.max(1, size * 0.012);
        ctx.stroke();
      }
      ctx.restore();
    }
  }

  // 5. メイン前面ボディ（3D角度に連動して光源ハイライト位置が移動するグラデーション）
  ctx.save();
  if (!silhouetteOnly && hasGlow) {
    ctx.shadowColor = cursed ? '#d946ef' : rInfo.color;
    ctx.shadowBlur = cursed ? size * 0.24 : size * 0.19;
  }

  const lightX = -r * 0.28 + sinYaw * r * 0.42;
  const lightY = -r * 0.32 + sinPitch * r * 0.42;
  const grad = ctx.createRadialGradient(lightX, lightY, r * 0.06, 0, 0, r * 1.18);

  if (silhouetteOnly) {
    grad.addColorStop(0, '#334155');
    grad.addColorStop(0.65, '#0f172a');
    grad.addColorStop(1, '#020617');
  } else if (cursed) {
    grad.addColorStop(0, '#fae8ff');
    grad.addColorStop(0.32, '#c026d3');
    grad.addColorStop(0.78, '#4c0519');
    grad.addColorStop(1, '#14021f');
  } else {
    grad.addColorStop(0, '#ffffff');
    grad.addColorStop(0.24, item.c1);
    grad.addColorStop(0.76, item.c2);
    grad.addColorStop(1, '#090d16');
  }

  ctx.fillStyle = grad;
  ctx.strokeStyle = silhouetteOnly
    ? (cursed ? 'rgba(217, 70, 239, 0.75)' : 'rgba(56, 189, 248, 0.7)')
    : 'rgba(255, 255, 255, 0.82)';
  ctx.lineWidth = Math.max(1.5, size * 0.018);

  traceGemShapePath(ctx, item.shape, r);
  ctx.fill();
  ctx.stroke();
  ctx.restore();

  // 6. 形状固有の3Dディテール（スカルの眼窩・鼻腔・歯列 / 水晶玉の内部星雲視差 / 魔眼）
  if (item.shape === 'skull') {
    ctx.save();
    // 視差に応じて顔のパーツもわずかに立体移動
    const faceShiftX = sinYaw * r * 0.14;
    const faceShiftY = sinPitch * r * 0.12;
    ctx.translate(faceShiftX, faceShiftY);

    ctx.fillStyle = silhouetteOnly ? '#020617' : '#090412';
    ctx.beginPath();
    ctx.ellipse(-r * 0.25, -r * 0.05, r * 0.16, r * 0.19, -0.15, 0, Math.PI * 2);
    ctx.ellipse(r * 0.25, -r * 0.05, r * 0.16, r * 0.19, 0.15, 0, Math.PI * 2);
    ctx.fill();

    if (!silhouetteOnly) {
      ctx.fillStyle = cursed ? '#f0abfc' : '#ffffff';
      ctx.shadowColor = cursed ? '#e879f9' : '#38bdf8';
      ctx.shadowBlur = 8;
      ctx.beginPath();
      ctx.arc(-r * 0.25 + sinYaw * 2, -r * 0.05 + sinPitch * 2, r * 0.048, 0, Math.PI * 2);
      ctx.arc(r * 0.25 + sinYaw * 2, -r * 0.05 + sinPitch * 2, r * 0.048, 0, Math.PI * 2);
      ctx.fill();
      ctx.shadowBlur = 0;
    }

    ctx.fillStyle = silhouetteOnly ? '#020617' : '#090412';
    ctx.beginPath();
    ctx.moveTo(0, r * 0.14);
    ctx.lineTo(r * 0.09, r * 0.32);
    ctx.lineTo(-r * 0.09, r * 0.32);
    ctx.closePath();
    ctx.fill();

    ctx.strokeStyle = silhouetteOnly ? 'rgba(148,163,184,0.35)' : 'rgba(255,255,255,0.62)';
    ctx.lineWidth = Math.max(1, size * 0.012);
    ctx.beginPath();
    ctx.moveTo(-r * 0.28, r * 0.56);
    ctx.lineTo(r * 0.28, r * 0.56);
    for (let tx = -0.16; tx <= 0.16; tx += 0.16) {
      ctx.moveTo(r * tx, r * 0.45);
      ctx.lineTo(r * tx, r * 0.78);
    }
    ctx.stroke();
    ctx.restore();
  } else if (item.shape === 'crystal_ball' && !silhouetteOnly) {
    const orbR = r * 0.72;
    const orbY = -r * 0.12;
    ctx.save();
    ctx.beginPath();
    ctx.arc(0, orbY, orbR * 0.92, 0, Math.PI * 2);
    ctx.clip();

    // 3D回転視差で動く内部星雲＆エネルギーリング
    const innerX = -sinYaw * orbR * 0.28;
    const innerY = -sinPitch * orbR * 0.28;
    ctx.strokeStyle = 'rgba(255, 255, 255, 0.42)';
    ctx.lineWidth = size * 0.028;
    ctx.beginPath();
    ctx.ellipse(innerX, orbY + innerY, orbR * 0.56, orbR * 0.28, yaw * 0.6, 0, Math.PI * 2);
    ctx.stroke();

    ctx.fillStyle = 'rgba(255, 255, 255, 0.72)';
    ctx.beginPath();
    ctx.ellipse(-orbR * 0.35 + sinYaw * 8, orbY - orbR * 0.35 + sinPitch * 8, orbR * 0.26, orbR * 0.12, -0.7, 0, Math.PI * 2);
    ctx.fill();
    ctx.restore();
  } else if (item.shape === 'eye' && !silhouetteOnly) {
    ctx.save();
    ctx.fillStyle = '#090d16';
    ctx.beginPath();
    ctx.arc(sinYaw * r * 0.18, sinPitch * r * 0.14, r * 0.28, 0, Math.PI * 2);
    ctx.fill();
    ctx.restore();
  }

  // 7. 3D角度に応じて視差移動する多面カット（テーブルファセット）＆スペキュラ光沢
  if (!silhouetteOnly && item.shape !== 'crystal_ball') {
    ctx.save();
    const facetShiftX = sinYaw * r * 0.18;
    const facetShiftY = sinPitch * r * 0.18;

    // 内部テーブル面の輪郭線
    ctx.strokeStyle = 'rgba(255, 255, 255, 0.38)';
    ctx.lineWidth = Math.max(1, size * 0.011);
    ctx.beginPath();
    ctx.moveTo(-r * 0.30 + facetShiftX, -r * 0.36 + facetShiftY);
    ctx.lineTo(r * 0.30 + facetShiftX, -r * 0.36 + facetShiftY);
    ctx.lineTo(r * 0.40 + facetShiftX, r * 0.14 + facetShiftY);
    ctx.lineTo(facetShiftX, r * 0.46 + facetShiftY);
    ctx.lineTo(-r * 0.40 + facetShiftX, r * 0.14 + facetShiftY);
    ctx.closePath();
    ctx.stroke();

    // 角度によってキラッと移動する光沢ハイライト
    ctx.fillStyle = 'rgba(255, 255, 255, 0.76)';
    ctx.beginPath();
    ctx.ellipse(-r * 0.22 + facetShiftX * 1.1, -r * 0.34 + facetShiftY * 1.1, r * 0.18, r * 0.065, -0.45 + sinYaw * 0.3, 0, Math.PI * 2);
    ctx.fill();

    // 十字スタースパークル
    const sx = r * 0.26 + facetShiftX * 0.8;
    const sy = -r * 0.32 + facetShiftY * 0.8;
    const sr = r * (0.14 + 0.05 * Math.abs(sinYaw + sinPitch));
    ctx.fillStyle = '#ffffff';
    ctx.beginPath();
    ctx.moveTo(sx, sy - sr);
    ctx.quadraticCurveTo(sx, sy, sx + sr, sy);
    ctx.quadraticCurveTo(sx, sy, sx, sy + sr);
    ctx.quadraticCurveTo(sx, sy, sx - sr, sy);
    ctx.quadraticCurveTo(sx, sy, sx, sy - sr);
    ctx.fill();
    ctx.restore();
  }

  ctx.restore();
}

