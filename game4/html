/**
 * ============================================================================
 * 9. 全250種コレクション図鑑 ＆ インタラクティブ3D回転詳細ビューア
 * ============================================================================
 */
function renderEncyclopedia() {
  const grid = document.getElementById('encyclopediaGrid');
  grid.innerHTML = '';

  ITEMS_250.forEach(item => {
    const disc = state.discovered[item.id];
    const rInfo = RARITY_INFO[item.rarity];

    if (state.currentFilter === 'discovered' && !disc) return;
    if (state.currentFilter === 'rare' && (!disc || !rInfo.glow)) return;
    if (state.currentFilter === 'cursed' && (!disc || !disc.cursed)) return;

    const card = document.createElement('button');
    const hasNeon = disc && (rInfo.glow || disc.cursed);
    card.className = `p-2 rounded-xl border flex flex-col items-center justify-between gap-1 transition ${
      disc
        ? (hasNeon
            ? 'bg-slate-900/90 border-amber-300/60 shadow-[0_0_15px_rgba(251,191,36,0.25)] hover:scale-[1.03]'
            : 'bg-white/10 border-white/20 hover:bg-white/15')
        : 'bg-black/40 border-white/5 opacity-55'
    }`;

    if (disc) {
      const cvs = document.createElement('canvas');
      cvs.width = 90;
      cvs.height = 90;
      cvs.className = 'w-14 h-14 sm:w-16 sm:h-16';
      // 図鑑一覧でも立体的な角度(yaw/pitch)で表示
      drawGlossyGem(cvs.getContext('2d'), item, 45, 45, 74, {
        cursed: disc.cursed,
        yaw: 0.28,
        pitch: 0.15
      });

      card.innerHTML = `<div class="w-full flex justify-between text-[9px] font-black"><span class="text-slate-400">#${String(item.id).padStart(3, '0')}</span><span style="color:${rInfo.color}">${item.rarity}</span></div>`;
      card.appendChild(cvs);

      const title = document.createElement('div');
      title.className = 'text-[10px] font-bold text-white truncate w-full text-center';
      title.textContent = (disc.cursed ? '💀' : '') + item.name;
      card.appendChild(title);

      card.onclick = () => openDetailModal(item, { cursed: disc.cursed, purified: disc.purified });
    } else {
      card.innerHTML = `
        <div class="w-full text-left text-[9px] text-slate-500 font-bold">#${String(item.id).padStart(3, '0')}</div>
        <div class="w-14 h-14 flex items-center justify-center text-slate-600 font-black text-lg">？</div>
        <div class="text-[10px] text-slate-500 truncate w-full text-center">未発見</div>
      `;
    }

    grid.appendChild(card);
  });
}

// 図鑑詳細・鑑定モーダル用 3D回転ステート
const detail3D = {
  item: null,
  cursed: false,
  yaw: 0.3,
  pitch: 0.15,
  velYaw: 0.012,
  velPitch: 0,
  isDragging: false,
  lastX: 0,
  lastY: 0
};

function openDetailModal(item, meta = {}) {
  const rInfo = RARITY_INFO[item.rarity];
  const shapeObj = SHAPES_23.find(s => s.id === item.shape);

  detail3D.item = item;
  detail3D.cursed = !!meta.cursed;
  detail3D.yaw = 0.28;
  detail3D.pitch = 0.14;
  detail3D.velYaw = 0.012; // 最初はゆっくり自動展示回転し、触ると自由操作へ切り替わる
  detail3D.velPitch = 0;
  detail3D.isDragging = false;

  const badge = document.getElementById('detailRarityBadge');
  badge.textContent = meta.cursed ? `💀 呪詛封印・${rInfo.label}` : rInfo.label;
  badge.style.backgroundColor = 'rgba(255,255,255,0.12)';
  badge.style.color = meta.cursed ? '#f0abfc' : rInfo.color;
  badge.style.border = `1px solid ${meta.cursed ? '#d946ef' : rInfo.color}`;

  document.getElementById('detailNo').textContent = `No.${String(item.id).padStart(3, '0')}`;
  document.getElementById('detailName').textContent = item.name;
  document.getElementById('detailShape').textContent = `形状：${shapeObj ? shapeObj.name : item.shape}`;
  document.getElementById('detailLore').textContent = item.lore;
  document.getElementById('detailExtra').textContent = meta.bonusCoins
    ? `🎉 鑑定ボーナス +${meta.bonusCoins} 🪙 獲得！`
    : `所持数: ${state.discovered[item.id]?.count || 1} 個`;

  document.getElementById('detailModal').classList.remove('hidden');
}

function renderDetail3DLoop() {
  const modal = document.getElementById('detailModal');
  if (!modal.classList.contains('hidden') && detail3D.item) {
    const cvs = document.getElementById('detailCanvas');
    const ctx = cvs.getContext('2d');
    const w = cvs.width;
    const h = cvs.height;

    if (!detail3D.isDragging) {
      detail3D.yaw += detail3D.velYaw;
      detail3D.pitch += detail3D.velPitch;
      // 慣性減衰（程よい余韻を残しつつゆっくり揺れる）
      detail3D.velYaw *= 0.94;
      detail3D.velPitch *= 0.92;
      // 角度が大きく傾きすぎた場合は優しく正面付近へ戻るスプリング
      detail3D.pitch *= 0.96;
      if (Math.abs(detail3D.velYaw) < 0.003) {
        detail3D.velYaw = 0.008 * Math.cos(performance.now() * 0.0012);
      }
    }

    // 上下チルト角は自然な範囲(-0.75〜0.75rad)にクランプ
    detail3D.pitch = Math.max(-0.75, Math.min(0.75, detail3D.pitch));

    ctx.clearRect(0, 0, w, h);

    // 3Dステージのスポットライトリング
    const rInfo = RARITY_INFO[detail3D.item.rarity];
    const auraColor = detail3D.cursed ? 'rgba(217, 70, 239, 0.25)' : 'rgba(56, 189, 248, 0.2)';
    const bgGrad = ctx.createRadialGradient(w / 2, h / 2, 10, w / 2, h / 2, w * 0.48);
    bgGrad.addColorStop(0, auraColor);
    bgGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
    ctx.fillStyle = bgGrad;
    ctx.fillRect(0, 0, w, h);

    // 回転台座リング（3Dパース楕円）
    ctx.save();
    ctx.strokeStyle = 'rgba(255, 255, 255, 0.14)';
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.ellipse(w / 2, h * 0.78, w * 0.28, h * 0.065, 0, 0, Math.PI * 2);
    ctx.stroke();
    ctx.restore();

    const floatOffset = Math.sin(performance.now() * 0.003) * 4;
    drawGlossyGem(ctx, detail3D.item, w / 2, h * 0.47 + floatOffset, w * 0.72, {
      cursed: detail3D.cursed,
      yaw: detail3D.yaw,
      pitch: detail3D.pitch
    });
  }
  requestAnimationFrame(renderDetail3DLoop);
}

/**
 * ============================================================================
 * 10. イベントバインド＆初期化
 * ============================================================================
 */
function switchTab(tabName) {
  document.querySelectorAll('.tab-btn').forEach(btn => {
    const active = btn.dataset.tab === tabName;
    btn.className = active
      ? 'tab-btn active py-2 px-1 rounded-xl text-xs sm:text-sm font-bold bg-gradient-to-r from-cyan-500/30 to-emerald-500/30 border border-cyan-300/60 text-white shadow-md transition'
      : 'tab-btn relative py-2 px-1 rounded-xl text-xs sm:text-sm font-bold bg-white/5 hover:bg-white/10 border border-white/10 text-slate-300 transition';
  });

  document.querySelectorAll('.view-section').forEach(sec => sec.classList.add('hidden'));
  document.getElementById(`view-${tabName}`).classList.remove('hidden');

  sound.setMode(tabName === 'gallery' ? 'gallery' : 'excavate');
  updateTopUI();

  if (tabName === 'polish') {
    renderRoughList();
    setupPolishRock(state.activeRoughUid || (state.roughRocks[0] && state.roughRocks[0].uid));
  } else if (tabName === 'gallery') {
    renderPedestals();
  } else if (tabName === 'encyclopedia') {
    renderEncyclopedia();
  }
}

window.addEventListener('DOMContentLoaded', () => {
  loadState();
  resizeExcavateCanvas();
  generateNewRock(false);
  updateTopUI();

  window.addEventListener('resize', resizeExcavateCanvas);

  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => switchTab(btn.dataset.tab));
  });
  document.getElementById('btnGoPolish').addEventListener('click', () => switchTab('polish'));

  document.getElementById('btnAudioToggle').addEventListener('click', (e) => {
    const on = sound.toggle();
    e.currentTarget.textContent = on ? '🔊' : '🔇';
    showToast(on ? '🎵 BGM・効果音 ON' : '🔇 サウンド OFF');
  });

  // 3D発掘キャンバス操作（タップで3D鉱石破壊）
  excavateCanvas.addEventListener('pointerdown', (e) => {
    handleExcavateInteract(e.clientX, e.clientY);
  });

  // 浅い層へ戻るボタン
  document.getElementById('btnReturnShallow').addEventListener('click', () => {
    if (state.depth >= 3000) state.depth = 500;
    else if (state.depth >= 500) state.depth = 0;
    else state.depth = 0;
    saveState();
    updateTopUI();
    generateNewRock(true);
    showToast(`▲ 深度 ${state.depth}m の層へ戻りました`);
  });

  document.getElementById('btnNewRock').addEventListener('click', () => {
    generateNewRock(true);
    sound.playPickaxeHit(0);
  });

  // 道具レベルアップ（コイン消費）
  document.getElementById('btnUpgradePickaxe').addEventListener('click', () => {
    const cost = state.pickaxeLv * 100;
    if (state.coins < cost) {
      showToast('🪙 コインが足りません！');
      return;
    }
    state.coins -= cost;
    state.pickaxeLv += 1;
    saveState();
    updateTopUI();
    generateNewRock(false);
    sound.playChime(1046.5, 0.12);
    showToast(`⛏️ 結晶ツルハシが Lv.${state.pickaxeLv} に強化された！`);
  });

  document.getElementById('btnUpgradeCloth').addEventListener('click', () => {
    const cost = state.clothLv * 120;
    if (state.coins < cost) {
      showToast('🪙 コインが足りません！');
      return;
    }
    state.coins -= cost;
    state.clothLv += 1;
    saveState();
    updateTopUI();
    sound.playChime(1174.66, 0.12);
    showToast(`✨ 星屑の研磨クロスが Lv.${state.clothLv} に強化された！`);
  });

  // 研磨キャンバス（擦り／スワイプ操作）
  polishCanvas.addEventListener('pointerdown', (e) => {
    sound.init();
    isRubbing = true;
    const rect = polishCanvas.getBoundingClientRect();
    lastRubPos = {
      x: (e.clientX - rect.left) * (polishCanvas.width / rect.width),
      y: (e.clientY - rect.top) * (polishCanvas.height / rect.height)
    };
  });
  polishCanvas.addEventListener('pointermove', (e) => {
    if (!isRubbing) return;
    rubAt(e.clientX, e.clientY);
  });

  // 図鑑詳細モーダル：タッチ／ドラッグ 3D回転操作
  const detailCanvas = document.getElementById('detailCanvas');
  detailCanvas.addEventListener('pointerdown', (e) => {
    detail3D.isDragging = true;
    detail3D.lastX = e.clientX;
    detail3D.lastY = e.clientY;
    detail3D.velYaw = 0;
    detail3D.velPitch = 0;
    detailCanvas.setPointerCapture(e.pointerId);
  });
  detailCanvas.addEventListener('pointermove', (e) => {
    if (!detail3D.isDragging) return;
    const dx = e.clientX - detail3D.lastX;
    const dy = e.clientY - detail3D.lastY;
    detail3D.lastX = e.clientX;
    detail3D.lastY = e.clientY;

    const sens = 0.014;
    detail3D.yaw += dx * sens;
    detail3D.pitch += dy * sens;
    detail3D.velYaw = dx * sens * 0.45;
    detail3D.velPitch = dy * sens * 0.35;
  });
  detailCanvas.addEventListener('pointerup', (e) => {
    detail3D.isDragging = false;
    try { detailCanvas.releasePointerCapture(e.pointerId); } catch (err) {}
  });
  detailCanvas.addEventListener('pointercancel', () => {
    detail3D.isDragging = false;
  });

  document.getElementById('btnReset3DAngle').addEventListener('click', () => {
    detail3D.yaw = 0;
    detail3D.pitch = 0;
    detail3D.velYaw = 0;
    detail3D.velPitch = 0;
    sound.playChime(1046.5, 0.06);
  });

  window.addEventListener('pointerup', () => {
    isRubbing = false;
    lastRubPos = null;
    detail3D.isDragging = false;
  });

  // 呪い・浄化 2択ボタン
  document.getElementById('btnPurify').addEventListener('click', () => {
    const rock = state.pendingCurseRock;
    document.getElementById('curseModal').classList.add('hidden');
    if (!rock) return;
    const item = ITEMS_250.find(it => it.id === rock.itemId);
    state.pendingCurseRock = null;
    finalizeDiscovery(item, false, true);
  });

  document.getElementById('btnKeepCurse').addEventListener('click', () => {
    const rock = state.pendingCurseRock;
    document.getElementById('curseModal').classList.add('hidden');
    if (!rock) return;
    const item = ITEMS_250.find(it => it.id === rock.itemId);
    state.pendingCurseRock = null;
    finalizeDiscovery(item, true, false);
  });

  const closeDetail = () => document.getElementById('detailModal').classList.add('hidden');
  document.getElementById('btnCloseDetail').addEventListener('click', closeDetail);
  document.getElementById('btnDetailOk').addEventListener('click', closeDetail);

  document.getElementById('btnCloseSelectPedestal').addEventListener('click', () => {
    document.getElementById('selectPedestalModal').classList.add('hidden');
  });
  document.getElementById('btnClearPedestal').addEventListener('click', () => {
    if (state.selectingPedestalIdx !== null) {
      state.pedestals[state.selectingPedestalIdx] = null;
      saveState();
      renderPedestals();
    }
    document.getElementById('selectPedestalModal').classList.add('hidden');
  });

  document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      state.currentFilter = btn.dataset.filter;
      document.querySelectorAll('.filter-btn').forEach(b => {
        b.classList.remove('bg-cyan-500/30', 'border-cyan-300/60', 'text-white');
        b.classList.add('bg-white/5', 'border-white/10');
      });
      btn.classList.remove('bg-white/5', 'border-white/10');
      btn.classList.add('bg-cyan-500/30', 'border-cyan-300/60', 'text-white');
      renderEncyclopedia();
    });
  });

  requestAnimationFrame(renderExcavateLoop);
  requestAnimationFrame(renderPolishFrame);
  requestAnimationFrame(renderMagicCircleLoop);
  requestAnimationFrame(renderDetail3DLoop);
});
</script>
