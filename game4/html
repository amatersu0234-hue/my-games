/**
 * ============================================================================
 * 1. Web Audio API プロシージャル BGM & SE エンジン
 * ============================================================================
 */
class SoundEngine {
  constructor() {
    this.ctx = null;
    this.enabled = false;
    this.mode = 'excavate';
    this.bgmTimer = null;
    this.step = 0;
  }

  init() {
    if (!this.ctx) {
      const AudioCtx = window.AudioContext || window.webkitAudioContext;
      if (AudioCtx) this.ctx = new AudioCtx();
    }
    if (this.ctx && this.ctx.state === 'suspended') {
      this.ctx.resume();
    }
  }

  toggle() {
    this.init();
    this.enabled = !this.enabled;
    if (this.enabled) {
      this.startBgm();
      this.playChime(660, 0.12);
    } else {
      this.stopBgm();
    }
    return this.enabled;
  }

  setMode(mode) {
    if (this.mode === mode) return;
    this.mode = mode;
    this.step = 0;
    if (this.enabled) {
      this.startBgm();
    }
  }

  startBgm() {
    this.stopBgm();
    if (!this.enabled || !this.ctx) return;

    const crystalScale = [523.25, 659.25, 783.99, 987.77, 1046.5, 987.77, 783.99, 659.25,
                          587.33, 739.99, 880.00, 1174.66, 1046.5, 880.00, 739.99, 587.33];
    const arcaneWaltz = [220.00, 261.63, 329.63, 415.30, 329.63, 261.63,
                         246.94, 293.66, 369.99, 440.00, 369.99, 293.66];

    const interval = this.mode === 'gallery' ? 420 : 340;
    this.bgmTimer = setInterval(() => {
      if (!this.enabled || !this.ctx) return;
      const notes = this.mode === 'gallery' ? arcaneWaltz : crystalScale;
      const freq = notes[this.step % notes.length];
      this.step++;
      this.playTone(freq, this.mode === 'gallery' ? 'triangle' : 'sine', 0.45, 0.035);
    }, interval);
  }

  stopBgm() {
    if (this.bgmTimer) {
      clearInterval(this.bgmTimer);
      this.bgmTimer = null;
    }
  }

  playTone(freq, type = 'sine', duration = 0.2, volume = 0.08) {
    if (!this.enabled || !this.ctx) return;
    try {
      const now = this.ctx.currentTime;
      const osc = this.ctx.createOscillator();
      const gain = this.ctx.createGain();
      osc.type = type;
      osc.frequency.setValueAtTime(freq, now);
      gain.gain.setValueAtTime(0.0001, now);
      gain.gain.exponentialRampToValueAtTime(volume, now + 0.02);
      gain.gain.exponentialRampToValueAtTime(0.0001, now + duration);
      osc.connect(gain);
      gain.connect(this.ctx.destination);
      osc.start(now);
      osc.stop(now + duration + 0.02);
    } catch (e) {}
  }

  playPickaxeHit(combo = 0) {
    const pitch = 380 + Math.min(combo, 10) * 55;
    this.playTone(pitch, 'triangle', 0.13, 0.14);
    this.playTone(130, 'sawtooth', 0.09, 0.08);
    setTimeout(() => this.playTone(pitch * 1.5, 'sine', 0.09, 0.08), 25);
  }

  playOreShatter() {
    [523.25, 659.25, 783.99, 1046.5, 1318.5].forEach((f, idx) => {
      setTimeout(() => this.playTone(f, 'sine', 0.26, 0.11), idx * 42);
    });
  }

  playRubShimmer(progress) {
    const f = 700 + (progress / 100) * 650 + (Math.random() * 140 - 70);
    this.playTone(f, 'sine', 0.08, 0.04);
  }

  playChime(base = 880, vol = 0.1) {
    this.playTone(base, 'sine', 0.22, vol);
    setTimeout(() => this.playTone(base * 1.25, 'sine', 0.3, vol * 0.85), 70);
  }

  playCurseSound() {
    this.playTone(146.83, 'sawtooth', 0.55, 0.08);
    setTimeout(() => this.playTone(138.59, 'sawtooth', 0.65, 0.08), 160);
  }
}

