/**
 * ============================================================================
 * 8. 魔術師の骨董展示室（魔法陣アニメーション背景維持 ＋ 擬似3D展示浮遊）
 * ============================================================================
 */
const magicCanvas = document.getElementById('magicCircleCanvas');
const mcCtx = magicCanvas.getContext('2d');
let magicAngle = 0;

function renderMagicCircleLoop() {
  const rect = magicCanvas.parentElement.getBoundingClientRect();
  if (rect.width > 0 && rect.height > 0) {
    magicCanvas.width = rect.width;
    magicCanvas.height = rect.height;
    const cx = rect.width / 2;
    const cy = rect.height / 2;
    const maxR = Math.min(rect.width, rect.height) * 0.46;

    mcCtx.clearRect(0, 0, rect.width, rect.height);
    mcCtx.save();
    mcCtx.translate(cx, cy);

    mcCtx.rotate(magicAngle);
    mcCtx.strokeStyle = 'rgba(217, 70, 239, 0.25)';
    mcCtx.shadowColor = '#d946ef';
    mcCtx.shadowBlur = 15;
    mcCtx.lineWidth = 2;

    mcCtx.beginPath();
    mcCtx.arc(0, 0, maxR, 0, Math.PI * 2);
    mcCtx.stroke();

    mcCtx.beginPath();
    mcCtx.arc(0, 0, maxR * 0.86, 0, Math.PI * 2);
    mcCtx.stroke();

    for (let t = 0; t < 2; t++) {
      mcCtx.beginPath();
      for (let i = 0; i < 3; i++) {
        const a = (Math.PI * 2 / 3) * i + (t * Math.PI / 3);
        const px = Math.cos(a) * maxR * 0.86;
        const py = Math.sin(a) * maxR * 0.86;
        if (i === 0) mcCtx.moveTo(px, py); else mcCtx.lineTo(px, py);
      }
      mcCtx.closePath();
      mcCtx.stroke();
    }

    mcCtx.rotate(-magicAngle * 2.2);
    mcCtx.strokeStyle = 'rgba(251, 191, 36, 0.22)';
    mcCtx.beginPath();
    mcCtx.arc(0, 0, maxR * 0.48, 0, Math.PI * 2);
    mcCtx.stroke();

    mcCtx.restore();
    magicAngle += 0.0035;
  }

  // 展示室の台座上にある宝石もリアルタイムでゆっくり擬似3D回転＆キラメキ更新
  const pedestalCanvases = document.querySelectorAll('.pedestal-3d-canvas');
  if (pedestalCanvases.length > 0 && !document.getElementById('view-gallery').classList.contains('hidden')) {
    const now = performance.now() * 0.0014;
    pedestalCanvases.forEach((cvs, i) => {
      const itemId = Number(cvs.dataset.itemId);
      const item = ITEMS_250.find(it => it.id === itemId);
      const disc = state.discovered[itemId];
      if (!item || !disc) return;
      const ctx = cvs.getContext('2d');
      ctx.clearRect(0, 0, cvs.width, cvs.height);
      const floatY = Math.sin(now * 1.8 + i) * 3;
      drawGlossyGem(ctx, item, 60, 58 + floatY, 96, {
        cursed: disc.cursed,
        yaw: Math.sin(now + i * 0.9) * 0.42,
        pitch: Math.cos(now * 0.7 + i) * 0.18
      });
    });
  }

  requestAnimationFrame(renderMagicCircleLoop);
}

