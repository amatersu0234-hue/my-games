<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>宝石＆秘宝発掘コレクション</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;800&family=Inter:wght@400;600;800&family=Noto+Sans+JP:wght@400;700;900&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-top: #042421;
      --bg-bottom: #020c0e;
      --accent-glow: rgba(16, 185, 129, 0.35);
    }
    * {
      box-sizing: border-box;
      user-select: none;
      -webkit-user-select: none;
      -webkit-tap-highlight-color: transparent;
    }
    body {
      margin: 0;
      min-height: 100vh;
      font-family: 'Noto Sans JP', 'Inter', sans-serif;
      color: #f1f5f9;
      background: radial-gradient(circle at 50% 15%, var(--bg-top), var(--bg-bottom) 85%);
      transition: background 1.2s ease;
      overflow-x: hidden;
    }
    .font-cinzel {
      font-family: 'Cinzel', serif;
    }
    /* 層ごとの背景テーマ (0m / 500m / 3000m) */
    body.layer-1 {
      --bg-top: #063d37;
      --bg-bottom: #031314;
      --accent-glow: rgba(52, 211, 153, 0.35);
    }
    body.layer-2 {
      --bg-top: #1e1659;
      --bg-bottom: #09061d;
      --accent-glow: rgba(139, 92, 246, 0.42);
    }
    body.layer-3 {
      --bg-top: #4d0b1d;
      --bg-bottom: #120206;
      --accent-glow: rgba(244, 63, 94, 0.48);
    }
    /* 展示室モード */
    body.mode-gallery {
      background: radial-gradient(circle at 50% 25%, #231130 0%, #0d0614 70%, #050208 100%) !important;
    }
    .glass-panel {
      background: rgba(12, 18, 32, 0.74);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.14);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.12);
    }
    .neon-border {
      box-shadow: 0 0 18px var(--accent-glow), inset 0 0 10px rgba(255, 255, 255, 0.08);
    }
    @keyframes candleFlicker {
      0%, 100% { transform: scale(1) rotate(-2deg); opacity: 0.92; }
      33% { transform: scale(1.08, 0.94) rotate(2deg); opacity: 1; }
      66% { transform: scale(0.95, 1.05) rotate(-1deg); opacity: 0.85; }
    }
    .candle-flame {
      animation: candleFlicker 1.8s infinite ease-in-out;
      transform-origin: bottom center;
    }
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: rgba(0, 0, 0, 0.25);
      border-radius: 999px;
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.25);
      border-radius: 999px;
    }
  </style>
</head>
<body class="layer-1 flex flex-col min-h-screen">

  <!-- 上部ステータスバー -->
  <header class="sticky top-0 z-30 glass-panel border-b border-white/15 px-3 py-2.5 sm:px-6">
    <div class="max-w-5xl mx-auto flex flex-wrap items-center justify-between gap-2">
      <div class="flex items-center gap-2.5">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-emerald-400 via-cyan-500 to-indigo-600 flex items-center justify-center shadow-lg shadow-cyan-500/30 text-lg">
          💎
        </div>
        <div>
          <h1 class="text-sm sm:text-base font-black tracking-wide bg-gradient-to-r from-white via-cyan-100 to-amber-200 bg-clip-text text-transparent">
            宝石＆秘宝発掘コレクション
          </h1>
          <div class="flex items-center gap-2 text-[11px] text-slate-300">
            <span id="headerLayerBadge" class="px-2 py-0.5 rounded-full bg-emerald-500/20 border border-emerald-400/40 text-emerald-200 font-bold">
              第1層：翠玉の表層
            </span>
            <span>深度 <strong id="headerDepth" class="text-white">0m</strong></span>
          </div>
        </div>
      </div>

      <div class="flex items-center gap-2 sm:gap-3">
        <!-- コイン -->
        <div class="px-3 py-1.5 rounded-xl bg-amber-950/60 border border-amber-400/40 flex items-center gap-1.5 shadow-inner">
          <span class="text-sm">🪙</span>
          <span id="headerCoins" class="text-xs sm:text-sm font-extrabold text-amber-300">0</span>
        </div>
        <!-- 図鑑発見数 -->
        <div class="px-3 py-1.5 rounded-xl bg-indigo-950/60 border border-indigo-400/40 flex items-center gap-1.5">
          <span class="text-sm">📖</span>
          <span class="text-xs sm:text-sm font-extrabold text-indigo-200"><span id="headerFoundCount">0</span>/250</span>
        </div>
        <!-- BGM/SE 切替 -->
        <button id="btnAudioToggle" class="p-2 rounded-xl bg-white/10 hover:bg-white/20 border border-white/15 text-sm transition active:scale-95" title="BGM・効果音切替">
          🔇
        </button>
      </div>
    </div>

    <!-- ナビゲーションタブ -->
    <nav class="max-w-5xl mx-auto grid grid-cols-4 gap-1.5 sm:gap-2 mt-2.5">
      <button data-tab="excavate" class="tab-btn active py-2 px-1 rounded-xl text-xs sm:text-sm font-bold bg-gradient-to-r from-cyan-500/30 to-emerald-500/30 border border-cyan-300/60 text-white shadow-md transition">
        ⛏️ 発掘
      </button>
      <button data-tab="polish" class="tab-btn relative py-2 px-1 rounded-xl text-xs sm:text-sm font-bold bg-white/5 hover:bg-white/10 border border-white/10 text-slate-300 transition">
        ✨ 研磨
        <span id="polishBadge" class="hidden absolute -top-1.5 -right-1 px-1.5 py-0.5 text-[10px] font-black rounded-full bg-rose-500 text-white shadow">0</span>
      </button>
      <button data-tab="gallery" class="tab-btn py-2 px-1 rounded-xl text-xs sm:text-sm font-bold bg-white/5 hover:bg-white/10 border border-white/10 text-slate-300 transition">
        🕯️ 展示室
      </button>
      <button data-tab="encyclopedia" class="tab-btn py-2 px-1 rounded-xl text-xs sm:text-sm font-bold bg-white/5 hover:bg-white/10 border border-white/10 text-slate-300 transition">
        📚 図鑑
      </button>
    </nav>
  </header>

  <!-- メインコンテンツ領域 -->
  <main class="flex-1 max-w-5xl w-full mx-auto p-3 sm:p-5 flex flex-col gap-4">

    <!-- ==================== 1. 擬似3D発掘モード（完全維持） ==================== -->
    <section id="view-excavate" class="view-section flex flex-col gap-4">
      <!-- 深度＆階層コントロールバー -->
      <div class="glass-panel rounded-2xl p-3.5 sm:p-4 flex flex-wrap items-center justify-between gap-3 neon-border">
        <div class="flex flex-col gap-1">
          <div class="flex items-center gap-2">
            <span id="layerTitle" class="text-sm sm:text-base font-black text-emerald-300">第1層：翠玉の表層 (0m〜499m)</span>
          </div>
          <p id="layerDesc" class="text-xs text-slate-300">3D坑道の奥に鎮座する立体鉱石岩塊をタップ＆連打して打ち砕こう！</p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <button id="btnReturnShallow" class="px-3 py-2 rounded-xl bg-slate-800/90 hover:bg-slate-700 border border-white/20 text-xs font-bold text-cyan-200 transition active:scale-95">
            ▲ 浅い層へ戻る
          </button>
          <button id="btnNewRock" class="px-3 py-2 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-xs font-black text-slate-950 shadow-lg transition active:scale-95">
            ⛏️ 次の岩盤へ前進
          </button>
        </div>
      </div>

      <!-- 擬似3D発掘キャンバスエリア＆道具レベルアップ -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
        <!-- 擬似3D発掘キャンバス -->
        <div class="lg:col-span-2 glass-panel rounded-2xl p-3 flex flex-col items-center justify-center relative overflow-hidden">
          <div class="w-full flex items-center justify-between text-xs text-slate-300 mb-2 px-1">
            <span id="excavatePrompt" class="font-bold text-cyan-200">✨ 立体鉱石岩塊をタップして結晶脈を打ち砕こう！</span>
            <span id="oreStatusTag" class="px-2.5 py-0.5 rounded-full bg-cyan-500/20 border border-cyan-400/40 text-cyan-200 font-bold text-[11px]">岩塊耐久: 5/5</span>
          </div>
          <div id="excavateCanvasWrap" class="w-full aspect-[4/3] max-h-[430px] rounded-xl overflow-hidden border border-white/20 relative bg-black/60 cursor-pointer shadow-inner">
            <canvas id="excavateCanvas" class="w-full h-full block"></canvas>
          </div>
        </div>

        <!-- 道具レベルアップ（コイン強化） -->
        <div class="glass-panel rounded-2xl p-4 flex flex-col justify-between gap-3">
          <div>
            <h2 class="text-sm font-black text-amber-300 flex items-center gap-1.5 mb-1">
              <span>⚒️</span> 道具レベルアップ
            </h2>
            <p class="text-[11px] text-slate-300 mb-3">発掘で手に入れたコインで道具を強化すると、より深く速くレア秘宝を掘り出せます。</p>

            <div class="space-y-2.5">
              <!-- ツルハシ強化 -->
              <div class="p-3 rounded-xl bg-white/5 border border-white/10">
                <div class="flex items-center justify-between mb-1">
                  <span class="text-xs font-bold text-white">⛏️ 結晶ツルハシ</span>
                  <span class="text-xs font-black text-cyan-300">Lv.<span id="pickaxeLv">1</span></span>
                </div>
                <p class="text-[11px] text-slate-400 mb-2">採掘深度進行UP ＆ 3D岩塊破壊パワーUP</p>
                <button id="btnUpgradePickaxe" class="w-full py-2 px-3 rounded-lg bg-amber-500/20 hover:bg-amber-500/30 border border-amber-400/50 text-xs font-black text-amber-200 transition active:scale-95 flex items-center justify-between">
                  <span>強化する</span>
                  <span>🪙 <span id="pickaxeCost">100</span></span>
                </button>
              </div>

              <!-- 研磨クロス強化 -->
              <div class="p-3 rounded-xl bg-white/5 border border-white/10">
                <div class="flex items-center justify-between mb-1">
                  <span class="text-xs font-bold text-white">✨ 星屑の研磨クロス</span>
                  <span class="text-xs font-black text-fuchsia-300">Lv.<span id="clothLv">1</span></span>
                </div>
                <p class="text-[11px] text-slate-400 mb-2">研磨スピードUP ＆ レア発光率UP</p>
                <button id="btnUpgradeCloth" class="w-full py-2 px-3 rounded-lg bg-fuchsia-500/20 hover:bg-fuchsia-500/30 border border-fuchsia-400/50 text-xs font-black text-fuchsia-200 transition active:scale-95 flex items-center justify-between">
                  <span>強化する</span>
                  <span>🪙 <span id="clothCost">120</span></span>
                </button>
              </div>
            </div>
          </div>

          <!-- 原石ストックへのショートカット -->
          <div class="p-3 rounded-xl bg-cyan-950/50 border border-cyan-400/30 flex items-center justify-between">
            <div>
              <div class="text-[11px] text-cyan-200">未研磨の原石ストック</div>
              <div class="text-base font-black text-white"><span id="roughStockCount">0</span> 個</div>
            </div>
            <button id="btnGoPolish" class="px-3.5 py-2 rounded-xl bg-cyan-400 hover:bg-cyan-300 text-slate-950 text-xs font-black shadow transition active:scale-95">
              研磨へ行く →
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== 2. 研磨モード（擦る操作＋シルエット出現） ==================== -->
    <section id="view-polish" class="view-section hidden flex flex-col gap-4">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
        <!-- 左：未研磨リスト -->
        <div class="glass-panel rounded-2xl p-4 flex flex-col gap-2.5 max-h-[480px]">
          <h2 class="text-sm font-black text-cyan-200 flex items-center justify-between">
            <span>🪨 未研磨の原石一覧</span>
            <span class="text-xs text-slate-400 font-normal">選択して研磨</span>
          </h2>
          <div id="roughList" class="flex-1 overflow-y-auto space-y-2 pr-1"></div>
        </div>

        <!-- 右：擦り研磨ステージ -->
        <div class="lg:col-span-2 glass-panel rounded-2xl p-4 flex flex-col items-center justify-between gap-3 neon-border">
          <div class="w-full flex flex-wrap items-center justify-between gap-2">
            <div>
              <span id="polishStageLabel" class="text-xs font-black px-2.5 py-1 rounded-full bg-cyan-500/20 border border-cyan-400/40 text-cyan-200">
                指やカーソルで原石を「擦って」磨こう！
              </span>
            </div>
            <div class="text-xs font-bold text-slate-300">
              研磨度: <strong id="polishPercent" class="text-base text-amber-300">0%</strong>
            </div>
          </div>

          <!-- 研磨プログレスバー -->
          <div class="w-full h-3 rounded-full bg-black/50 border border-white/15 overflow-hidden">
            <div id="polishProgressBar" class="h-full w-0 bg-gradient-to-r from-cyan-400 via-fuchsia-400 to-amber-300 transition-all duration-150"></div>
          </div>

          <!-- 研磨Canvas -->
          <div id="polishCanvasWrap" class="w-full max-w-[380px] aspect-square rounded-2xl overflow-hidden border border-white/20 bg-slate-950/90 relative shadow-2xl touch-none cursor-grab active:cursor-grabbing">
            <canvas id="polishCanvas" class="w-full h-full block"></canvas>
          </div>

          <p class="text-[11px] text-slate-300 text-center">
            ※タップではなく<strong class="text-cyan-300">画面をなぞるように擦る（スワイプする）</strong>と岩殻が削れ、ネオン光彩とともに立体シルエットが浮かび上がります。
          </p>
        </div>
      </div>
    </section>

    <!-- ==================== 3. 魔術師の骨董展示室（魔法陣背景維持＋擬似3D展示） ==================== -->
    <section id="view-gallery" class="view-section hidden flex flex-col gap-4">
      <div class="relative rounded-3xl overflow-hidden border border-amber-500/30 shadow-2xl p-4 sm:p-6 bg-[#12071d]">
        <!-- 背景の魔法陣アニメーションCanvas -->
        <canvas id="magicCircleCanvas" class="absolute inset-0 w-full h-full pointer-events-none opacity-75"></canvas>

        <!-- 展示室ヘッダー＆キャンドル演出 -->
        <div class="relative z-10 flex items-center justify-between mb-4">
          <div class="flex items-center gap-2">
            <span class="candle-flame inline-block text-xl">🕯️</span>
            <div>
              <h2 class="font-cinzel text-base sm:text-xl font-extrabold text-amber-200 tracking-wider">
                ARCANE RELIC GALLERY
              </h2>
              <p class="text-xs text-purple-200/80">魔術師の怪しい骨董展示室 — 台座をタップして秘宝を飾ろう</p>
            </div>
          </div>
          <span class="candle-flame inline-block text-xl">🕯️</span>
        </div>

        <!-- 9枠ガラス展示台座 -->
        <div id="pedestalGrid" class="relative z-10 grid grid-cols-3 gap-2.5 sm:gap-4"></div>
      </div>
    </section>

    <!-- ==================== 4. 全250種コレクション図鑑 ==================== -->
    <section id="view-encyclopedia" class="view-section hidden flex flex-col gap-4">
      <div class="glass-panel rounded-2xl p-4 flex flex-col gap-3">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div>
            <h2 class="text-base font-black text-white">📚 宝石＆秘宝大図鑑（全250種・23シェイプ）</h2>
            <p class="text-xs text-slate-300">タップで詳細を開き、指で触って3D回転・鑑賞できます✨</p>
          </div>
          <div class="flex flex-wrap gap-1.5">
            <button data-filter="all" class="filter-btn active px-3 py-1.5 rounded-lg bg-cyan-500/30 border border-cyan-300/60 text-xs font-bold text-white">すべて</button>
            <button data-filter="discovered" class="filter-btn px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-xs font-bold text-slate-300">発見済み</button>
            <button data-filter="rare" class="filter-btn px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-xs font-bold text-amber-300">✨ レア発光</button>
            <button data-filter="cursed" class="filter-btn px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-xs font-bold text-fuchsia-300">💀 呪詛封印</button>
          </div>
        </div>

        <div id="encyclopediaGrid" class="grid grid-cols-3 sm:grid-cols-5 md:grid-cols-6 gap-2.5 max-h-[62vh] overflow-y-auto pr-1"></div>
      </div>
    </section>
  </main>

  <!-- ==================== モーダル：呪い・浄化 2択儀式 ==================== -->
  <div id="curseModal" class="fixed inset-0 z-50 hidden bg-black/80 backdrop-blur-md flex items-center justify-center p-4">
    <div class="max-w-md w-full rounded-3xl bg-gradient-to-b from-[#230b36] to-[#0d0516] border-2 border-fuchsia-500/60 p-5 sm:p-6 shadow-[0_0_50px_rgba(192,38,211,0.5)] text-center flex flex-col items-center gap-3">
      <span class="px-3 py-1 rounded-full bg-fuchsia-500/20 border border-fuchsia-400/50 text-xs font-black text-fuchsia-200 animate-pulse">
        ⚠️ 禍々しい呪詛の気配を検知！
      </span>
      <h3 class="text-lg font-black text-white">封印された呪いをどうしますか？</h3>
      <canvas id="cursePreviewCanvas" width="180" height="180" class="w-36 h-36 rounded-2xl bg-black/50 border border-fuchsia-400/30"></canvas>
      <div id="curseItemName" class="text-base font-black text-amber-200"></div>
      <p class="text-xs text-slate-300 leading-relaxed">
        聖水で浄化すると清らかな輝きとボーナスコインを獲得します。<br>
        呪詛を封印保持すると妖しい紫炎オーラを纏い、展示価値が大幅に上昇します。
      </p>
      <div class="grid grid-cols-2 gap-2.5 w-full mt-2">
        <button id="btnPurify" class="py-3 px-2 rounded-2xl bg-gradient-to-r from-cyan-400 to-emerald-400 text-slate-950 font-black text-xs sm:text-sm shadow-lg hover:brightness-110 transition active:scale-95">
          ✨ 聖水で浄化する<br><span class="text-[10px] font-bold opacity-80">ボーナスコイン獲得</span>
        </button>
        <button id="btnKeepCurse" class="py-3 px-2 rounded-2xl bg-gradient-to-r from-fuchsia-600 to-purple-800 border border-fuchsia-300/50 text-white font-black text-xs sm:text-sm shadow-lg hover:brightness-110 transition active:scale-95">
          💀 呪詛を封印保持<br><span class="text-[10px] font-bold text-fuchsia-200">妖艶オーラ＆価値1.8倍</span>
        </button>
      </div>
    </div>
  </div>

  <!-- ==================== モーダル：鑑定結果 / 図鑑詳細（タッチ3D回転対応！） ==================== -->
  <div id="detailModal" class="fixed inset-0 z-50 hidden bg-black/85 backdrop-blur-md flex items-center justify-center p-4">
    <div class="max-w-sm w-full glass-panel rounded-3xl border border-white/25 p-5 sm:p-6 text-center flex flex-col items-center gap-3 relative">
      <button id="btnCloseDetail" class="absolute top-3 right-3 w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 text-white text-sm font-bold z-10">✕</button>
      <div id="detailRarityBadge" class="px-3 py-0.5 rounded-full text-xs font-black"></div>

      <!-- インタラクティブ 3D回転ステージ -->
      <div class="relative w-52 h-52 sm:w-56 sm:h-56 rounded-2xl bg-gradient-to-b from-slate-900/90 to-black/90 border border-cyan-400/30 shadow-[inset_0_0_25px_rgba(56,189,248,0.15)] overflow-hidden touch-none cursor-grab active:cursor-grabbing">
        <canvas id="detailCanvas" width="260" height="260" class="w-full h-full block"></canvas>
        <div class="pointer-events-none absolute bottom-2 left-1/2 -translate-x-1/2 px-2.5 py-0.5 rounded-full bg-black/70 border border-white/15 text-[10px] font-bold text-cyan-200 whitespace-nowrap flex items-center gap-1">
          <span>👆</span> 指でなぞって3D回転
        </div>
        <button id="btnReset3DAngle" class="absolute top-2 left-2 px-2 py-0.5 rounded-lg bg-white/10 hover:bg-white/20 border border-white/15 text-[10px] font-bold text-slate-200 transition" title="正面角度へリセット">
          ↺ 正面
        </button>
      </div>

      <div>
        <div id="detailNo" class="text-[11px] text-slate-400 font-bold"></div>
        <h3 id="detailName" class="text-lg font-black text-white"></h3>
        <div id="detailShape" class="text-xs text-cyan-300 font-bold mt-0.5"></div>
      </div>
      <p id="detailLore" class="text-xs text-slate-300 leading-relaxed bg-black/35 p-3 rounded-xl border border-white/10 w-full"></p>
      <div id="detailExtra" class="text-xs font-bold text-amber-300"></div>
      <button id="btnDetailOk" class="w-full py-2.5 rounded-xl bg-gradient-to-r from-cyan-400 to-indigo-500 text-slate-950 font-black text-sm shadow-lg mt-0.5">
        コレクションに収める
      </button>
    </div>
  </div>

  <!-- ==================== モーダル：展示台座のアイテム選択 ==================== -->
