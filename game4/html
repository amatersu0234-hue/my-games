/**
 * ============================================================================
 * 6. 擬似3D発掘エンジン（完全維持：3Dパース坑道トンネル ＋ 立体多面体鉱石岩塊）
 * ============================================================================
 */
const excavateCanvas = document.getElementById('excavateCanvas');
const exCtx = excavateCanvas.getContext('2d');

function create3DRockMesh(seed) {
  const rings = 5;
  const sectors = 8;
  const vertices = [];
  const faces = [];

  vertices.push({ x: 0, y: -1.08, z: 0 });

  for (let r = 1; r < rings; r++) {
    const phi = (Math.PI * r) / rings;
    const sinP = Math.sin(phi);
    const cosP = -Math.cos(phi);
    for (let s = 0; s < sectors; s++) {
      const theta = (Math.PI * 2 * s) / sectors + (r % 2) * 0.22;
      const bump = 0.84 + 0.28 * Math.abs(Math.sin(seed * 3.1 + r * 2.7 + s * 4.3));
      vertices.push({
        x: sinP * Math.cos(theta) * bump * 1.12,
        y: cosP * bump * 0.96,
        z: sinP * Math.sin(theta) * bump * 1.12
      });
    }
  }

  const bottomIdx = vertices.length;
  vertices.push({ x: 0, y: 1.02, z: 0 });

  for (let s = 0; s < sectors; s++) {
    const next = (s + 1) % sectors;
    faces.push([0, 1 + next, 1 + s]);
  }
  for (let r = 0; r < rings - 2; r++) {
    const row1 = 1 + r * sectors;
    const row2 = 1 + (r + 1) * sectors;
    for (let s = 0; s < sectors; s++) {
      const next = (s + 1) % sectors;
      faces.push([row1 + s, row1 + next, row2 + next]);
      faces.push([row1 + s, row2 + next, row2 + s]);
    }
  }
  const lastRow = 1 + (rings - 2) * sectors;
  for (let s = 0; s < sectors; s++) {
    const next = (s + 1) % sectors;
    faces.push([bottomIdx, lastRow + s, lastRow + next]);
  }

  return { vertices, faces };
}

