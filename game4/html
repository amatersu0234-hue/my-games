function resizeExcavateCanvas() {
  const rect = excavateCanvas.parentElement.getBoundingClientRect();
  const dpr = Math.min(window.devicePixelRatio || 1, 2);
  excavateCanvas.width = rect.width * dpr;
  excavateCanvas.height = rect.height * dpr;
  exCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
}

function generateNewRock(withForwardDash = true) {
  const maxHp = Math.max(2, 6 - Math.floor(state.pickaxeLv * 0.6));
  const curseChance = state.depth >= 3000 ? 0.35 : (state.depth >= 500 ? 0.24 : 0.15);

  rock3D.mesh = create3DRockMesh(Math.random() * 100);
  rock3D.rotY = Math.random() * Math.PI * 2;
  rock3D.rotX = 0.24 + (Math.random() - 0.5) * 0.12;
  rock3D.targetSpin = 0.35;
  rock3D.scaleBounce = 0.65;
  rock3D.shake = 0;
  rock3D.tunnelAdvance = withForwardDash ? 1.0 : 0;
  rock3D.oreHp = maxHp;
  rock3D.oreMaxHp = maxHp;
  rock3D.oreCursed = Math.random() < curseChance;
  rock3D.hitCombo = 0;

  document.getElementById('excavatePrompt').textContent = '✨ 立体鉱石岩塊をタップ連打で砕き、内部の原石を掘り出そう！';
  document.getElementById('oreStatusTag').textContent = `岩塊耐久: ${rock3D.oreHp}/${rock3D.oreMaxHp}`;
}

function pickRandomItemForDepth(depth) {
  const boost = (depth >= 3000 ? 35 : (depth >= 500 ? 18 : 0)) + (state.clothLv - 1) * 3;
  const roll = Math.random() * 100 + boost;
  let targetRarity = 'N';
  if (roll > 118) targetRarity = 'MYTHIC';
  else if (roll > 98) targetRarity = 'SSR';
  else if (roll > 75) targetRarity = 'SR';
  else if (roll > 45) targetRarity = 'R';

  const candidates = ITEMS_250.filter(it => it.rarity === targetRarity && it.minDepth <= depth);
  const pool = candidates.length > 0 ? candidates : ITEMS_250;
  return pool[Math.floor(Math.random() * pool.length)];
}

function spawn3DDebris(cx, cy, color, rockColor, count = 14) {
  for (let i = 0; i < count; i++) {
    const ang = Math.random() * Math.PI * 2;
    const spd = 2.0 + Math.random() * 5.2;
    rock3D.debris3D.push({
      x: cx + (Math.random() - 0.5) * 30,
      y: cy + (Math.random() - 0.5) * 30,
      z: 1.0,
      vx: Math.cos(ang) * spd,
      vy: Math.sin(ang) * spd - 2.2,
      vz: 0.03 + Math.random() * 0.045,
      rot: Math.random() * Math.PI * 2,
      vrot: (Math.random() - 0.5) * 0.25,
      size: 5 + Math.random() * 7,
      isCrystal: i % 3 === 0,
      color: i % 3 === 0 ? color : rockColor,
      life: 1.0
    });
  }
}

function handleExcavateInteract(clientX, clientY) {
  sound.init();
  const rect = excavateCanvas.getBoundingClientRect();
  const x = clientX - rect.left;
  const y = clientY - rect.top;
  const layer = getLayerInfo(state.depth);

  rock3D.hitCombo++;
  rock3D.oreHp -= 1;
  rock3D.shake = 11;
  rock3D.scaleBounce = 1.13;
  rock3D.targetSpin += 0.42;
  rock3D.pickaxeSwing = 1.0;
  rock3D.pickaxeTarget = { x, y };

  sound.playPickaxeHit(rock3D.hitCombo);
  const glowCol = rock3D.oreCursed ? '#e879f9' : layer.veinColor;
  spawn3DDebris(x, y, glowCol, layer.rockFront, 12);

  if (rock3D.oreHp > 0) {
    document.getElementById('oreStatusTag').textContent = `岩塊耐久: ${rock3D.oreHp}/${rock3D.oreMaxHp}`;
    if (rock3D.oreHp === 1) {
      document.getElementById('excavatePrompt').textContent = '💥 あと一撃！内部の結晶コアが輝き出している！';
    }
  } else {
    sound.playOreShatter();
    const cx = rect.width * 0.5;
    const cy = rect.height * 0.54;
    spawn3DDebris(cx, cy, '#fde047', layer.rockTop, 32);

    const prevLayer = getLayerInfo(state.depth).id;
    const depthGain = 35 + state.pickaxeLv * 25;
    state.depth += depthGain;
    const newLayer = getLayerInfo(state.depth).id;

    const coinGain = 25 + Math.floor(state.depth * 0.04) + state.pickaxeLv * 10;
    state.coins += coinGain;

    const item = pickRandomItemForDepth(state.depth);
    const uid = 'rock_' + Date.now() + '_' + Math.random().toString(36).slice(2, 6);
    state.roughRocks.unshift({
      uid,
      itemId: item.id,
      isCursed: rock3D.oreCursed,
      progress: 0
    });
    if (!state.activeRoughUid) state.activeRoughUid = uid;

    saveState();
    updateTopUI();

    if (newLayer !== prevLayer) {
      showToast(`🌋 深度 ${state.depth}m 到達！新たな3D地層へ突入しました！`);
    } else {
      showToast(`💎 立体鉱石を粉砕！原石塊を獲得 (+${depthGain}m / +${coinGain}🪙)`);
    }

    generateNewRock(true);
  }
}

function project3DVertex(v, rotX, rotY, scale, cx, cy) {
  const cosY = Math.cos(rotY);
  const sinY = Math.sin(rotY);
  const x1 = v.x * cosY - v.z * sinY;
  const z1 = v.x * sinY + v.z * cosY;

  const cosX = Math.cos(rotX);
  const sinX = Math.sin(rotX);
  const y2 = v.y * cosX - z1 * sinX;
  const z2 = v.y * sinX + z1 * cosX;

  const fov = 3.4;
  const persp = fov / (fov + z2);
  return {
    x: cx + x1 * scale * persp,
    y: cy + y2 * scale * persp,
    z: z2,
    x3: x1,
    y3: y2
  };
}

function renderExcavateLoop() {
  const w = excavateCanvas.parentElement.clientWidth || 400;
  const h = excavateCanvas.parentElement.clientHeight || 300;
  const layer = getLayerInfo(state.depth);
  const now = performance.now() * 0.001;

  rock3D.rotY += 0.006 + rock3D.targetSpin * 0.08;
  rock3D.targetSpin *= 0.88;
  rock3D.scaleBounce += (1 - rock3D.scaleBounce) * 0.16;
  rock3D.tunnelAdvance *= 0.90;
  if (rock3D.pickaxeSwing > 0) {
    rock3D.pickaxeSwing = Math.max(0, rock3D.pickaxeSwing - 0.08);
  }

  exCtx.save();
  if (rock3D.shake > 0) {
    exCtx.translate((Math.random() - 0.5) * rock3D.shake, (Math.random() - 0.5) * rock3D.shake);
    rock3D.shake *= 0.82;
    if (rock3D.shake < 0.4) rock3D.shake = 0;
  }

  const vpX = w * 0.5;
  const vpY = h * 0.44;

  const bgGrad = exCtx.createRadialGradient(vpX, vpY, 8, vpX, vpY, Math.max(w, h) * 0.78);
  bgGrad.addColorStop(0, layer.veinColor);
  bgGrad.addColorStop(0.22, layer.rockFront);
  bgGrad.addColorStop(0.68, layer.rockSide);
  bgGrad.addColorStop(1, layer.rockDeep);
  exCtx.fillStyle = bgGrad;
  exCtx.fillRect(0, 0, w, h);

  const ringCount = 6;
  const advanceOffset = (1 - rock3D.tunnelAdvance) + (now * 0.12) % 1;
  for (let i = 0; i < ringCount; i++) {
    const t = ((i + advanceOffset) % ringCount) / ringCount;
    const persp = Math.pow(t, 1.65);
    const rw = w * (0.14 + persp * 1.15);
    const rh = h * (0.14 + persp * 1.15);

    exCtx.save();
    exCtx.strokeStyle = layer.tunnelEdge;
    exCtx.globalAlpha = 0.15 + persp * 0.45;
    exCtx.lineWidth = 1 + persp * 2.5;

    const cut = 0.24;
    exCtx.beginPath();
    exCtx.moveTo(vpX - rw * (0.5 - cut), vpY - rh * 0.5);
    exCtx.lineTo(vpX + rw * (0.5 - cut), vpY - rh * 0.5);
    exCtx.lineTo(vpX + rw * 0.5, vpY - rh * (0.5 - cut));
    exCtx.lineTo(vpX + rw * 0.5, vpY + rh * (0.5 - cut));
    exCtx.lineTo(vpX + rw * (0.5 - cut), vpY + rh * 0.5);
    exCtx.lineTo(vpX - rw * (0.5 - cut), vpY + rh * 0.5);
    exCtx.lineTo(vpX - rw * 0.5, vpY + rh * (0.5 - cut));
    exCtx.lineTo(vpX - rw * 0.5, vpY - rh * (0.5 - cut));
    exCtx.closePath();
    exCtx.stroke();
    exCtx.restore();
  }

  exCtx.save();
  exCtx.strokeStyle = 'rgba(255, 255, 255, 0.09)';
  exCtx.lineWidth = 1.2;
  const corners = [
    [0, 0], [w, 0], [w, h], [0, h],
    [w * 0.25, 0], [w * 0.75, 0], [w * 0.25, h], [w * 0.75, h]
  ];
  corners.forEach(([cx2, cy2]) => {
    exCtx.beginPath();
    exCtx.moveTo(vpX, vpY);
    exCtx.lineTo(cx2, cy2);
    exCtx.stroke();
  });
  exCtx.restore();

  const rockCx = w * 0.5;
  const rockCy = h * 0.54;
  const baseRadius = Math.min(w, h) * 0.25 * rock3D.scaleBounce;

  exCtx.save();
  const shadowGrad = exCtx.createRadialGradient(rockCx, rockCy + baseRadius * 0.95, 5, rockCx, rockCy + baseRadius * 0.95, baseRadius * 1.25);
  shadowGrad.addColorStop(0, 'rgba(0, 0, 0, 0.75)');
  shadowGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
  exCtx.fillStyle = shadowGrad;
  exCtx.beginPath();
  exCtx.ellipse(rockCx, rockCy + baseRadius * 0.95, baseRadius * 1.2, baseRadius * 0.36, 0, 0, Math.PI * 2);
  exCtx.fill();
  exCtx.restore();

  const projVerts = rock3D.mesh.vertices.map(v =>
    project3DVertex(v, rock3D.rotX, rock3D.rotY, baseRadius, rockCx, rockCy)
  );

  const sortedFaces = rock3D.mesh.faces.map((f, idx) => {
    const p0 = projVerts[f[0]];
    const p1 = projVerts[f[1]];
    const p2 = projVerts[f[2]];
    const avgZ = (p0.z + p1.z + p2.z) / 3;

    const ux = p1.x3 - p0.x3, uy = p1.y3 - p0.y3, uz = p1.z - p0.z;
    const vx = p2.x3 - p0.x3, vy = p2.y3 - p0.y3, vz = p2.z - p0.z;
    const nx = uy * vz - uz * vy;
    const ny = uz * vx - ux * vz;
    const nz = ux * vy - uy * vx;
    const len = Math.hypot(nx, ny, nz) || 1;

    return { f, idx, p0, p1, p2, avgZ, nx: nx / len, ny: ny / len, nz: nz / len };
  }).sort((a, b) => b.avgZ - a.avgZ);

  const dmgRatio = 1 - (rock3D.oreHp / rock3D.oreMaxHp);
  const pulseGlow = 0.65 + 0.35 * Math.sin(now * 5);
  const crystalColor = rock3D.oreCursed ? '#e879f9' : layer.veinColor;

  exCtx.save();
  exCtx.shadowColor = crystalColor;
  exCtx.shadowBlur = 28 + dmgRatio * 25;
  exCtx.fillStyle = crystalColor;
  exCtx.globalAlpha = 0.16 + dmgRatio * 0.25;
  exCtx.beginPath();
  exCtx.arc(rockCx, rockCy, baseRadius * 0.88, 0, Math.PI * 2);
  exCtx.fill();
  exCtx.restore();

  sortedFaces.forEach(({ idx, p0, p1, p2, nz, ny }) => {
    if (nz > 0.12) return;

    const lightIntensity = Math.max(0, Math.min(1, (-nz * 0.75) + (-ny * 0.45) + 0.25));

    exCtx.beginPath();
    exCtx.moveTo(p0.x, p0.y);
    exCtx.lineTo(p1.x, p1.y);
    exCtx.lineTo(p2.x, p2.y);
    exCtx.closePath();

    const isCrystalFacet = (idx % 5 === 0) || (dmgRatio > 0.35 && idx % 3 === 0);
    if (isCrystalFacet) {
      exCtx.fillStyle = crystalColor;
      exCtx.globalAlpha = 0.35 + lightIntensity * 0.55 * pulseGlow;
    } else if (lightIntensity > 0.62) {
      exCtx.fillStyle = layer.rockTop;
      exCtx.globalAlpha = 0.96;
    } else if (lightIntensity > 0.32) {
      exCtx.fillStyle = layer.rockFront;
      exCtx.globalAlpha = 0.96;
    } else {
      exCtx.fillStyle = layer.rockSide;
      exCtx.globalAlpha = 0.98;
    }
    exCtx.fill();

    exCtx.globalAlpha = 0.28 + dmgRatio * 0.65;
    exCtx.strokeStyle = dmgRatio > 0.25 ? crystalColor : 'rgba(255, 255, 255, 0.24)';
    exCtx.lineWidth = dmgRatio > 0.5 ? 2.0 : 1.1;
    exCtx.stroke();
  });

  if (rock3D.pickaxeSwing > 0) {
    const t = rock3D.pickaxeSwing;
    const angle = -0.9 + (1 - t) * 1.45;
    exCtx.save();
    exCtx.translate(rock3D.pickaxeTarget.x + 28, rock3D.pickaxeTarget.y - 18);
    exCtx.rotate(angle);
    exCtx.shadowColor = '#38bdf8';
    exCtx.shadowBlur = 16;

    exCtx.strokeStyle = '#d97706';
    exCtx.lineWidth = 6;
    exCtx.lineCap = 'round';
    exCtx.beginPath();
    exCtx.moveTo(0, 0);
    exCtx.lineTo(38, 38);
    exCtx.stroke();

    exCtx.strokeStyle = '#67e8f9';
    exCtx.lineWidth = 7;
    exCtx.beginPath();
    exCtx.moveTo(-24, 18);
    exCtx.quadraticCurveTo(-8, -8, 18, -24);
    exCtx.stroke();
    exCtx.restore();
  }

  for (let i = rock3D.debris3D.length - 1; i >= 0; i--) {
    const d = rock3D.debris3D[i];
    d.x += d.vx * d.z;
    d.y += d.vy * d.z;
    d.vy += 0.22;
    d.z += d.vz;
    d.rot += d.vrot;
    d.life -= 0.028;

    if (d.life <= 0) {
      rock3D.debris3D.splice(i, 1);
      continue;
    }

    exCtx.save();
    exCtx.globalAlpha = Math.min(1, d.life * 1.2);
    exCtx.translate(d.x, d.y);
    exCtx.rotate(d.rot);
    exCtx.scale(d.z, d.z);
    if (d.isCrystal) {
      exCtx.shadowColor = d.color;
      exCtx.shadowBlur = 10;
    }
    exCtx.fillStyle = d.color;
    exCtx.strokeStyle = 'rgba(255,255,255,0.45)';
    exCtx.lineWidth = 1;

    const s = d.size;
    exCtx.beginPath();
    exCtx.moveTo(-s, -s * 0.4);
    exCtx.lineTo(s * 0.3, -s);
    exCtx.lineTo(s, s * 0.3);
    exCtx.lineTo(-s * 0.2, s * 0.9);
    exCtx.closePath();
    exCtx.fill();
    exCtx.stroke();
    exCtx.restore();
  }

  const barW = Math.min(180, w * 0.42);
  const barH = 7;
  const barX = rockCx - barW * 0.5;
  const barY = Math.min(h - 22, rockCy + baseRadius * 1.15);
  const hpRatio = Math.max(0, rock3D.oreHp / rock3D.oreMaxHp);

  exCtx.save();
  exCtx.fillStyle = 'rgba(0, 0, 0, 0.65)';
  exCtx.beginPath();
  exCtx.roundRect(barX, barY, barW, barH, 4);
  exCtx.fill();

  exCtx.fillStyle = crystalColor;
  exCtx.shadowColor = crystalColor;
  exCtx.shadowBlur = 10;
  exCtx.beginPath();
  exCtx.roundRect(barX, barY, barW * hpRatio, barH, 4);
  exCtx.fill();
  exCtx.restore();

  exCtx.restore();
  requestAnimationFrame(renderExcavateLoop);
}

/**
 * ============================================================================
 * 7. 擦り研磨システム（スワイプ／ドラッグで岩殻を削り擬似3Dシルエットが浮かぶ）
 * ============================================================================
 */
const polishCanvas = document.getElementById('polishCanvas');
const polCtx = polishCanvas.getContext('2d');
const rockMaskCanvas = document.createElement('canvas');
const maskCtx = rockMaskCanvas.getContext('2d');

let isRubbing = false;
let lastRubPos = null;
let rubParticles = [];

function setupPolishRock(uid) {
  state.activeRoughUid = uid;
  const rock = state.roughRocks.find(r => r.uid === uid);

  const size = 360;
  polishCanvas.width = size;
  polishCanvas.height = size;
  rockMaskCanvas.width = size;
  rockMaskCanvas.height = size;
  rubParticles = [];

  if (!rock) {
    document.getElementById('polishPercent').textContent = '0%';
    document.getElementById('polishProgressBar').style.width = '0%';
    document.getElementById('polishStageLabel').textContent = '発掘モードで原石を掘り出そう！';
    return;
  }

  maskCtx.globalCompositeOperation = 'source-over';
  maskCtx.clearRect(0, 0, size, size);

  const cx = size / 2;
  const cy = size / 2;
  const r = size * 0.36;

  const rockGrad = maskCtx.createRadialGradient(cx - 25, cy - 25, 15, cx, cy, r * 1.15);
  rockGrad.addColorStop(0, '#64748b');
  rockGrad.addColorStop(0.55, '#334155');
  rockGrad.addColorStop(1, '#0f172a');

  maskCtx.fillStyle = rockGrad;
  maskCtx.beginPath();
  for (let i = 0; i < 12; i++) {
    const ang = (Math.PI * 2 / 12) * i;
    const rad = r * (0.88 + (i % 3) * 0.08);
    const px = cx + Math.cos(ang) * rad;
    const py = cy + Math.sin(ang) * rad;
    if (i === 0) maskCtx.moveTo(px, py); else maskCtx.lineTo(px, py);
  }
  maskCtx.closePath();
  maskCtx.fill();

  maskCtx.strokeStyle = 'rgba(15, 23, 42, 0.6)';
  maskCtx.lineWidth = 3;
  maskCtx.stroke();

  maskCtx.fillStyle = 'rgba(226, 232, 240, 0.7)';
  maskCtx.font = '900 18px "Noto Sans JP", sans-serif';
  maskCtx.textAlign = 'center';
  maskCtx.fillText('？？？の原石塊', cx, cy + 6);

  updatePolishProgressUI(rock.progress);
}

function updatePolishProgressUI(progress) {
  const pct = Math.min(100, Math.floor(progress));
  document.getElementById('polishPercent').textContent = `${pct}%`;
  document.getElementById('polishProgressBar').style.width = `${pct}%`;

  const label = document.getElementById('polishStageLabel');
  if (pct < 30) {
    label.textContent = '第1段階：指で擦って硬い岩殻を削り落とそう！';
  } else if (pct < 75) {
    label.textContent = '第2段階：ネオン光彩とともに立体シルエットが浮かび上がってきた！';
  } else {
    label.textContent = '第3段階：仕上げ磨き！あと少しで真の姿が現れる！';
  }
}

function rubAt(clientX, clientY) {
  const rock = state.roughRocks.find(r => r.uid === state.activeRoughUid);
  if (!rock || rock.progress >= 100) return;

  const rect = polishCanvas.getBoundingClientRect();
  const scaleX = polishCanvas.width / rect.width;
  const scaleY = polishCanvas.height / rect.height;
  const x = (clientX - rect.left) * scaleX;
  const y = (clientY - rect.top) * scaleY;

  if (!lastRubPos) {
    lastRubPos = { x, y };
    return;
  }

  const dist = Math.hypot(x - lastRubPos.x, y - lastRubPos.y);
  if (dist < 4) return;

  const brushSize = 26 + state.clothLv * 4;
  maskCtx.save();
  maskCtx.globalCompositeOperation = 'destination-out';
  maskCtx.lineCap = 'round';
  maskCtx.lineWidth = brushSize;
  maskCtx.beginPath();
  maskCtx.moveTo(lastRubPos.x, lastRubPos.y);
  maskCtx.lineTo(x, y);
  maskCtx.stroke();
  maskCtx.restore();

  const gain = (dist / 24) * (1.1 + state.clothLv * 0.25);
  rock.progress = Math.min(100, rock.progress + gain);
  updatePolishProgressUI(rock.progress);
  sound.playRubShimmer(rock.progress);

  const neonCol = rock.isCursed ? '#e879f9' : '#38bdf8';
  for (let i = 0; i < 4; i++) {
    rubParticles.push({
      x: x + (Math.random() - 0.5) * 16,
      y: y + (Math.random() - 0.5) * 16,
      vx: (Math.random() - 0.5) * 3,
      vy: (Math.random() - 0.5) * 3 - 1,
      life: 1,
      color: neonCol
    });
  }

  lastRubPos = { x, y };

  if (rock.progress >= 100) {
    isRubbing = false;
    lastRubPos = null;
    completePolishing(rock);
  }
}

function renderPolishFrame() {
  const w = polishCanvas.width;
  const h = polishCanvas.height;
  const t = performance.now() * 0.0018;
  polCtx.clearRect(0, 0, w, h);

  const bg = polCtx.createRadialGradient(w / 2, h / 2, 10, w / 2, h / 2, w * 0.6);
  bg.addColorStop(0, '#0f172a');
  bg.addColorStop(1, '#020617');
  polCtx.fillStyle = bg;
  polCtx.fillRect(0, 0, w, h);

  const rock = state.roughRocks.find(r => r.uid === state.activeRoughUid);
  if (rock) {
    const item = ITEMS_250.find(it => it.id === rock.itemId);
    const pct = rock.progress;

    if (item) {
      // 磨きながらほんのり擬似3Dで揺れて立体感を見せる
      drawGlossyGem(polCtx, item, w / 2, h / 2, w * 0.68, {
        silhouetteOnly: pct < 72,
        cursed: rock.isCursed,
        yaw: Math.sin(t) * 0.32,
        pitch: Math.cos(t * 0.8) * 0.16
      });
    }

    polCtx.drawImage(rockMaskCanvas, 0, 0);
  } else {
    polCtx.fillStyle = '#64748b';
    polCtx.font = 'bold 14px "Noto Sans JP", sans-serif';
    polCtx.textAlign = 'center';
    polCtx.fillText('原石がありません', w / 2, h / 2);
  }

  for (let i = rubParticles.length - 1; i >= 0; i--) {
    const p = rubParticles[i];
    p.x += p.vx;
    p.y += p.vy;
    p.life -= 0.05;
    if (p.life <= 0) {
      rubParticles.splice(i, 1);
      continue;
    }
    polCtx.save();
    polCtx.globalAlpha = p.life;
    polCtx.fillStyle = p.color;
    polCtx.shadowColor = p.color;
    polCtx.shadowBlur = 10;
    polCtx.beginPath();
    polCtx.arc(p.x, p.y, 3, 0, Math.PI * 2);
    polCtx.fill();
    polCtx.restore();
  }

  requestAnimationFrame(renderPolishFrame);
}

function completePolishing(rock) {
  state.roughRocks = state.roughRocks.filter(r => r.uid !== rock.uid);
  state.activeRoughUid = state.roughRocks[0] ? state.roughRocks[0].uid : null;
  renderRoughList();
  updateTopUI();

  const item = ITEMS_250.find(it => it.id === rock.itemId);
  if (!item) return;

  if (rock.isCursed) {
    state.pendingCurseRock = rock;
    sound.playCurseSound();
    const cCanvas = document.getElementById('cursePreviewCanvas');
    const cCtx = cCanvas.getContext('2d');
    cCtx.clearRect(0, 0, 180, 180);
    drawGlossyGem(cCtx, item, 90, 90, 142, { cursed: true, yaw: 0.25, pitch: 0.15 });
    document.getElementById('curseItemName').textContent = item.name;
    document.getElementById('curseModal').classList.remove('hidden');
  } else {
    finalizeDiscovery(item, false, false);
  }
}

function finalizeDiscovery(item, isCursed, isPurified) {
  if (!state.discovered[item.id]) {
    state.discovered[item.id] = { count: 0, cursed: false, purified: false };
  }
  state.discovered[item.id].count += 1;
  if (isCursed) state.discovered[item.id].cursed = true;
  if (isPurified) state.discovered[item.id].purified = true;

  let bonusCoins = RARITY_INFO[item.rarity].value;
  if (isPurified) bonusCoins = Math.round(bonusCoins * 1.5);
  state.coins += bonusCoins;

  saveState();
  updateTopUI();
  setupPolishRock(state.activeRoughUid);
  sound.playChime(987.77, 0.12);

  openDetailModal(item, {
    isNew: true,
    cursed: isCursed,
    purified: isPurified,
    bonusCoins
  });
}

function renderRoughList() {
  const listEl = document.getElementById('roughList');
  listEl.innerHTML = '';

  if (state.roughRocks.length === 0) {
    listEl.innerHTML = `<div class="text-xs text-slate-400 text-center py-8">未研磨の原石はありません。<br>「⛏️ 発掘」タブで掘り出そう！</div>`;
    return;
  }

  state.roughRocks.forEach((rock, idx) => {
    const isSelected = rock.uid === state.activeRoughUid;
    const btn = document.createElement('button');
    btn.className = `w-full p-2.5 rounded-xl border text-left flex items-center justify-between transition ${
      isSelected
        ? 'bg-cyan-500/25 border-cyan-300 text-white shadow'
        : 'bg-white/5 hover:bg-white/10 border-white/10 text-slate-300'
    }`;
